{
  "name": "car-sharing",
  "version": "0.0.1",
  "private": true,
  "description": "Nền tảng chia sẻ xe tự lái (Car Sharing) - MVP",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=24.15.0",
    "pnpm": ">=12.0.0"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm --filter @carsharing/api run test:all",
    "test:smoke": "pnpm --filter @carsharing/web run test:smoke",
    "test:security": "node tools/security-audit.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:seed": "prisma db seed",
    "export:openapi": "node tools/export-openapi.mjs"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "prettier": "^3.5.0",
    "prisma": "6.19.3",
    "tsx": "^4.23.15",
    "typescript": "~5.8.2"
  },
  "dependencies": {
    "@prisma/client": "6.19.3"
  }
}
