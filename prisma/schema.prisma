// Prisma Schema for Car Sharing Platform
// Designed according to docs/DATABASE_DESIGN.md and docs/API_CONTRACT.md

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// -----------------------------------------------------------------------------
// Enums
// -----------------------------------------------------------------------------

enum CarType {
  SEDAN
  SUV
  HATCHBACK
  MPV
  CROSSOVER
}

enum Transmission {
  AUTO
  MANUAL
}

enum VehicleStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum MediaPurpose {
  VEHICLE_PHOTO
  INSPECTION_PHOTO
  IDENTITY_DOCUMENT
}

enum MediaState {
  STAGING
  VERIFIED
  REJECTED
}

enum BookingStatus {
  REQUESTED
  APPROVED
  REJECTED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  EXPIRED
}

enum CalendarKind {
  BOOKING
  OWNER_BLOCK
}

enum InspectionType {
  CHECK_IN
  CHECK_OUT
}

enum InspectionAngle {
  FRONT
  REAR
  LEFT
  RIGHT
}

enum KeylessAction {
  LOCK
  UNLOCK
}

enum KeylessOperationStatus {
  PENDING
  SUCCESS
  FAILED
  UNKNOWN
}

enum KycStatus {
  NONE
  PENDING
  VERIFIED
  REJECTED
}

// -----------------------------------------------------------------------------
// Models
// -----------------------------------------------------------------------------

model User {
  id              String    @id @default(uuid()) @db.Uuid
  name            String
  emailNormalized String    @unique @map("email_normalized")
  phone           String
  passwordHash    String?   @map("password_hash")
  kycStatus       KycStatus @default(NONE) @map("kyc_status")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  driverLicense   DriverLicense?
  oauthAccounts   OAuthAccount[]
  refreshSessions RefreshSession[]
  ownedVehicles   Vehicle[]        @relation("UserOwnedVehicles")
  rentedBookings  Booking[]        @relation("UserRentedBookings")
  ownedBookings   Booking[]        @relation("UserOwnedBookings")
  uploadedMedia   MediaObject[]
  writtenReviews  Review[]         @relation("ReviewAuthor")
  receivedReviews Review[]         @relation("ReviewTarget")
  inspections     Inspection[]
  bookingEvents   BookingEvent[]
  notifications   Notification[]

  @@map("users")
}

model DriverLicense {
  id              String    @id @default(uuid()) @db.Uuid
  userId          String    @unique @map("user_id") @db.Uuid
  licenseNumber   String    @map("license_number")
  fullName        String    @map("full_name")
  dateOfBirth     DateTime  @map("date_of_birth") @db.Date
  licenseClass    String    @map("license_class")
  expiryDate      DateTime  @map("expiry_date") @db.Date
  status          KycStatus @default(PENDING)
  verifiedAt      DateTime? @map("verified_at") @db.Timestamptz(6)
  rejectionReason String?   @map("rejection_reason")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("driver_licenses")
}

model OAuthAccount {
  id       String @id @default(uuid()) @db.Uuid
  userId   String @map("user_id") @db.Uuid
  provider String
  subject  String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, subject])
  @@map("oauth_accounts")
}

model RefreshSession {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash")
  familyId   String    @map("family_id") @db.Uuid
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(6)
  replacedBy String?   @map("replaced_by") @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([familyId])
  @@map("refresh_sessions")
}

model Vehicle {
  id               String        @id @default(uuid()) @db.Uuid
  ownerId          String        @map("owner_id") @db.Uuid
  brand            String
  model            String
  year             Int
  plateNormalized  String        @unique @map("plate_normalized")
  city             String
  pickupAddress    String        @map("pickup_address")
  carType          CarType       @map("car_type")
  transmission     Transmission  @map("transmission")
  seats            Int
  description      String        @db.Text
  pricePerDayVnd   BigInt        @map("price_per_day_vnd")
  keylessSupported Boolean       @default(false) @map("keyless_supported")
  status           VehicleStatus @default(DRAFT)
  version          Int           @default(1)
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  owner        User              @relation("UserOwnedVehicles", fields: [ownerId], references: [id], onDelete: Restrict)
  amenities    VehicleAmenity[]
  photos       VehiclePhoto[]
  bookings     Booking[]
  calendar     VehicleCalendar[]
  mediaObjects MediaObject[]

  @@index([status, city, pricePerDayVnd])
  @@map("vehicles")
}

model VehicleAmenity {
  vehicleId   String @map("vehicle_id") @db.Uuid
  amenityCode String @map("amenity_code")

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@id([vehicleId, amenityCode])
  @@map("vehicle_amenities")
}

model MediaObject {
  id         String       @id @default(uuid()) @db.Uuid
  uploaderId String       @map("uploader_id") @db.Uuid
  purpose    MediaPurpose
  vehicleId  String?      @map("vehicle_id") @db.Uuid
  bookingId  String?      @map("booking_id") @db.Uuid
  stagingKey String       @map("staging_key")
  finalKey   String?      @unique @map("final_key")
  mimeType   String       @map("mime_type")
  sizeBytes  Int          @map("size_bytes")
  checksum   String
  state      MediaState   @default(STAGING)
  verifiedAt DateTime?    @map("verified_at") @db.Timestamptz(6)
  createdAt  DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  uploader User     @relation(fields: [uploaderId], references: [id], onDelete: Restrict)
  vehicle  Vehicle? @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  booking  Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)

  vehiclePhotos    VehiclePhoto[]
  inspectionPhotos InspectionPhoto[]

  @@map("media_objects")
}

model VehiclePhoto {
  vehicleId String @map("vehicle_id") @db.Uuid
  mediaId   String @map("media_id") @db.Uuid
  position  Int

  vehicle Vehicle     @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  media   MediaObject @relation(fields: [mediaId], references: [id], onDelete: Restrict)

  @@id([vehicleId, mediaId])
  @@unique([vehicleId, position])
  @@map("vehicle_photos")
}

model Booking {
  id               String        @id @default(uuid()) @db.Uuid
  vehicleId        String        @map("vehicle_id") @db.Uuid
  renterId         String        @map("renter_id") @db.Uuid
  ownerId          String        @map("owner_id") @db.Uuid
  startAt          DateTime      @map("start_at") @db.Timestamptz(6)
  endAt            DateTime      @map("end_at") @db.Timestamptz(6)
  status           BookingStatus @default(REQUESTED)
  requestExpiresAt DateTime      @map("request_expires_at") @db.Timestamptz(6)
  completedAt      DateTime?     @map("completed_at") @db.Timestamptz(6)
  reason           String?
  version          Int           @default(1)
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  renter  User    @relation("UserRentedBookings", fields: [renterId], references: [id], onDelete: Restrict)
  owner   User    @relation("UserOwnedBookings", fields: [ownerId], references: [id], onDelete: Restrict)

  pricingSnapshot    PricingSnapshot?
  calendar           VehicleCalendar?
  idempotencyRecords IdempotencyRecord[]
  inspections        Inspection[]
  keylessOperations  KeylessOperation[]
  manualHandovers    ManualHandover[]
  reviews            Review[]
  events             BookingEvent[]
  notifications      Notification[]
  mediaObjects       MediaObject[]

  @@index([renterId, createdAt])
  @@index([ownerId, status])
  @@index([status, requestExpiresAt])
  @@map("bookings")
}

model PricingSnapshot {
  id             String   @id @default(uuid()) @db.Uuid
  bookingId      String   @unique @map("booking_id") @db.Uuid
  currency       String   @default("VND")
  pricePerDayVnd BigInt   @map("price_per_day_vnd")
  rentalDays     Int      @map("rental_days")
  subtotalVnd    BigInt   @map("subtotal_vnd")
  serviceFeeVnd  BigInt   @map("service_fee_vnd")
  depositVnd     BigInt   @map("deposit_vnd")
  totalVnd       BigInt   @map("total_vnd")
  pricingVersion String   @map("pricing_version")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Restrict)

  @@map("pricing_snapshots")
}

model IdempotencyRecord {
  id          String   @id @default(uuid()) @db.Uuid
  actorId     String   @map("actor_id") @db.Uuid
  operation   String
  key         String
  requestHash String   @map("request_hash")
  bookingId   String   @map("booking_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Restrict)

  @@unique([actorId, operation, key])
  @@map("idempotency_records")
}

model VehicleCalendar {
  id         String       @id @default(uuid()) @db.Uuid
  vehicleId  String       @map("vehicle_id") @db.Uuid
  bookingId  String?      @unique @map("booking_id") @db.Uuid
  kind       CalendarKind
  startAt    DateTime     @map("start_at") @db.Timestamptz(6)
  endAt      DateTime     @map("end_at") @db.Timestamptz(6)
  reason     String?
  releasedAt DateTime?    @map("released_at") @db.Timestamptz(6)
  createdAt  DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  vehicle Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  booking Booking? @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@map("vehicle_calendar")
}

model Inspection {
  id           String         @id @default(uuid()) @db.Uuid
  bookingId    String         @map("booking_id") @db.Uuid
  type         InspectionType
  odometerKm   Int            @map("odometer_km")
  fuelPercent  Int            @map("fuel_percent")
  damageNotes  String?        @map("damage_notes") @db.Text
  acknowledged Boolean        @default(false)
  finalizedAt  DateTime?      @map("finalized_at") @db.Timestamptz(6)
  version      Int            @default(1)
  performedBy  String         @map("performed_by") @db.Uuid
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  performer User    @relation(fields: [performedBy], references: [id], onDelete: Restrict)

  photos InspectionPhoto[]

  @@unique([bookingId, type])
  @@map("inspections")
}

model InspectionPhoto {
  inspectionId String          @map("inspection_id") @db.Uuid
  angle        InspectionAngle
  mediaId      String          @map("media_id") @db.Uuid

  inspection Inspection  @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  media      MediaObject @relation(fields: [mediaId], references: [id], onDelete: Restrict)

  @@id([inspectionId, angle])
  @@unique([inspectionId, mediaId])
  @@map("inspection_photos")
}

model KeylessOperation {
  id             String                 @id @default(uuid()) @db.Uuid
  bookingId      String                 @map("booking_id") @db.Uuid
  actorId        String                 @map("actor_id") @db.Uuid
  action         KeylessAction
  idempotencyKey String                 @map("idempotency_key")
  requestHash    String                 @map("request_hash")
  status         KeylessOperationStatus @default(PENDING)
  provider       String                 @default("SIMULATOR")
  deviceResult   String?                @map("device_result")
  leaseUntil     DateTime?              @map("lease_until") @db.Timestamptz(6)
  resolvedAt     DateTime?              @map("resolved_at") @db.Timestamptz(6)
  createdAt      DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)

  booking        Booking         @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  manualHandover ManualHandover?

  @@unique([actorId, bookingId, action, idempotencyKey])
  @@map("keyless_operations")
}

model ManualHandover {
  id                String        @id @default(uuid()) @db.Uuid
  bookingId         String        @map("booking_id") @db.Uuid
  operationId       String        @unique @map("operation_id") @db.Uuid
  action            KeylessAction
  reason            String
  ownerConfirmedAt  DateTime?     @map("owner_confirmed_at") @db.Timestamptz(6)
  renterConfirmedAt DateTime?     @map("renter_confirmed_at") @db.Timestamptz(6)
  finalizedAt       DateTime?     @map("finalized_at") @db.Timestamptz(6)
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  booking   Booking          @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  operation KeylessOperation @relation(fields: [operationId], references: [id], onDelete: Restrict)

  @@map("manual_handovers")
}

model Review {
  id           String   @id @default(uuid()) @db.Uuid
  bookingId    String   @map("booking_id") @db.Uuid
  authorId     String   @map("author_id") @db.Uuid
  targetUserId String   @map("target_user_id") @db.Uuid
  score        Int
  comment      String   @db.Text
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  booking    Booking @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  author     User    @relation("ReviewAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  targetUser User    @relation("ReviewTarget", fields: [targetUserId], references: [id], onDelete: Restrict)

  @@unique([bookingId, authorId])
  @@map("reviews")
}

model BookingEvent {
  id          String         @id @default(uuid()) @db.Uuid
  bookingId   String         @map("booking_id") @db.Uuid
  actorId     String?        @map("actor_id") @db.Uuid
  eventType   String         @map("event_type")
  fromStatus  BookingStatus? @map("from_status")
  toStatus    BookingStatus? @map("to_status")
  reason      String?
  operationId String?        @map("operation_id") @db.Uuid
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  actor   User?   @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([bookingId, createdAt])
  @@map("booking_events")
}

model Notification {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  bookingId String?   @map("booking_id") @db.Uuid
  eventId   String    @map("event_id") @db.Uuid
  type      String
  readAt    DateTime? @map("read_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  booking Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)

  @@unique([userId, eventId, type])
  @@map("notifications")
}
