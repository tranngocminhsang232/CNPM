{
  "name": "@carsharing/api",
  "version": "0.0.1",
  "private": true,
  "description": "Car Sharing API Backend - NestJS Modular Monolith",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "tsc -p tsconfig.json && node --test \"dist/src/**/*.spec.js\"",
    "test:e2e": "tsc -p tsconfig.json && node --test \"dist/test/**/*.e2e-spec.js\"",
    "test:constraints": "tsc -p tsconfig.json && node --test \"dist/test/constraints.integration-spec.js\"",
    "test:all": "tsc -p tsconfig.json && node --test \"dist/src/**/*.spec.js\" \"dist/test/**/*.e2e-spec.js\" \"dist/test/constraints.integration-spec.js\""
  },
  "dependencies": {
    "@nestjs/common": "12.2.0",
    "@nestjs/config": "12.0.1",
    "@nestjs/core": "12.2.0",
    "@nestjs/platform-express": "12.2.0",
    "@nestjs/swagger": "^12.0.4",
    "@prisma/client": "6.19.3",
    "bcryptjs": "^3.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "cookie-parser": "^1.4.7",
    "jsonwebtoken": "^9.0.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.10",
    "@nestjs/schematics": "12.0.2",
    "@nestjs/testing": "12.2.0",
    "@types/bcryptjs": "^3.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.0.0",
    "@types/supertest": "^6.0.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.3.1",
    "typescript": "~5.8.2"
  }
}
