{
  "openapi": "3.0.0",
  "paths": {
    "/api/v1/auth/csrf": {
      "get": {
        "operationId": "AuthController_getCsrfToken",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Trả về CSRF token và gắn cookie csrf_token",
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/CsrfResponseDto"
                    }
                  }
                }
              }
            }
          }
        },
        "summary": "Lấy mã xác thực CSRF gắn phiên hoặc trước phiên",
        "tags": ["Auth"]
      }
    },
    "/api/v1/auth/login": {
      "post": {
        "operationId": "AuthController_login",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Đăng nhập thành công, thiết lập session cookies",
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/AuthResponseDto"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Sai thông tin đăng nhập (INVALID_CREDENTIALS)"
          }
        },
        "summary": "Đăng nhập người dùng bằng email và mật khẩu",
        "tags": ["Auth"]
      }
    },
    "/api/v1/auth/register": {
      "post": {
        "operationId": "AuthController_register",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterDto"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Đăng ký thành công, tạo phiên và trả về thông tin user",
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/AuthResponseDto"
                    }
                  }
                }
              }
            }
          },
          "409": {
            "description": "Email đã tồn tại (EMAIL_IN_USE)"
          }
        },
        "summary": "Đăng ký tài khoản người dùng mới",
        "tags": ["Auth"]
      }
    },
    "/api/v1/auth/google": {
      "get": {
        "operationId": "AuthController_googleAuth",
        "parameters": [],
        "responses": {
          "302": {
            "description": "Chuyển hướng đến Google hoặc mock callback"
          }
        },
        "summary": "Khởi tạo luồng xác thực Google OAuth2/OIDC",
        "tags": ["Auth"]
      }
    },
    "/api/v1/auth/google/callback": {
      "get": {
        "operationId": "AuthController_googleCallback",
        "parameters": [
          {
            "name": "code",
            "required": true,
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "302": {
            "description": "Thiết lập cookie phiên và chuyển hướng về web"
          }
        },
        "summary": "Xử lý phản hồi từ Google OAuth2/OIDC",
        "tags": ["Auth"]
      }
    },
    "/api/v1/auth/logout": {
      "post": {
        "operationId": "AuthController_logout",
        "parameters": [],
        "responses": {
          "204": {
            "description": "Đăng xuất thành công, xóa cookie"
          }
        },
        "summary": "Đăng xuất tài khoản và thu hồi phiên làm việc",
        "tags": ["Auth"]
      }
    },
    "/api/v1/auth/me": {
      "get": {
        "operationId": "AuthController_getProfile[0]",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Thông tin tài khoản và năng lực của người dùng",
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "data": {
