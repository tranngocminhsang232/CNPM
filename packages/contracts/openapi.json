                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Chưa đăng nhập hoặc phiên hết hạn"
          }
        },
        "summary": "Lấy thông tin người dùng hiện tại từ phiên đăng nhập",
        "tags": ["Auth"]
      }
    },
    "/api/v1/me": {
      "get": {
        "operationId": "AuthController_getProfile[1]",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Thông tin tài khoản và năng lực của người dùng",
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/UserDto"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Chưa đăng nhập hoặc phiên hết hạn"
          }
        },
        "summary": "Lấy thông tin người dùng hiện tại từ phiên đăng nhập",
        "tags": ["Auth"]
      }
    },
    "/api/v1/users/me/driver-license": {
      "get": {
        "operationId": "UsersController_getMyDriverLicense",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Hồ sơ GPLX của người dùng hoặc null nếu chưa nộp",
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/DriverLicenseDto",
                      "nullable": true
                    }
                  }
                }
              }
            }
          }
        },
        "summary": "Xem thông tin giấy phép lái xe hiện tại của tôi",
        "tags": ["Users"]
      },
      "post": {
        "operationId": "UsersController_submitDriverLicense",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SubmitDriverLicenseDto"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Nộp GPLX thành công, trạng thái chuyển sang PENDING",
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/DriverLicenseDto"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Dữ liệu không hợp lệ (hết hạn, < 18 tuổi, sai số GPLX)"
          },
          "409": {
            "description": "GPLX đã được xác thực trước đó (ALREADY_VERIFIED)"
          }
        },
        "summary": "Nộp thông tin giấy phép lái xe (GPLX) để xác thực KYC",
        "tags": ["Users"]
      }
    },
    "/api/v1/users/{id}/driver-license/verify": {
      "post": {
        "operationId": "UsersController_verifyDriverLicense",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "description": "ID người dùng cần duyệt GPLX",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/VerifyDriverLicenseDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Cập nhật trạng thái KYC thành công",
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/DriverLicenseDto"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Không tìm thấy hồ sơ GPLX của người dùng"
          }
        },
        "summary": "Duyệt hoặc từ chối giấy phép lái xe (Admin / Mock Verification)",
        "tags": ["Users"]
      }
    },
    "/api/v1/media/upload-intents": {
      "post": {
        "operationId": "MediaController_createUploadIntent",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateUploadIntentDto"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Sinh presigned URL thành công",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UploadIntentResponseDto"
                }
              }
            }
          },
          "400": {
            "description": "Dữ liệu không hợp lệ (MIME hoặc dung lượng sai quy định)"
          }
        },
        "security": [
          {
            "bearer": []
          },
          {
            "access_token": []
          }
        ],
        "summary": "Tạo upload intent và sinh Presigned PUT URL để upload trực tiếp lên S3/MinIO",
        "tags": ["media"]
      }
    },
    "/api/v1/media/{id}/verify": {
      "post": {
        "operationId": "MediaController_verifyMedia",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Xác thực file thành công, file được chuyển từ staging sang finalized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MediaObjectDto"
                }
              }
            }
          },
          "400": {
            "description": "File chưa được tải lên storage thành công"
          },
          "403": {
            "description": "Không có quyền xác thực media của người khác"
          },
          "404": {
            "description": "Không tìm thấy media object"
          }
        },
        "security": [
          {
            "bearer": []
          },
          {
            "access_token": []
          }
        ],
        "summary": "Xác thực file đã tải lên storage thành công (probe S3) và chuyển trạng thái sang VERIFIED",
        "tags": ["media"]
      }
    },
    "/api/v1/media/{id}/read-url": {
      "get": {
        "operationId": "MediaController_getReadUrl",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Sinh URL xem file thành công (TTL 15 phút)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MediaReadUrlResponseDto"
                }
              }
            }
          },
          "400": {
            "description": "Media chưa hoàn tất xác thực"
          },
          "403": {
            "description": "Không có quyền truy cập tài liệu định danh này"
          },
          "404": {
            "description": "Không tìm thấy media object"
          }
        },
        "security": [
          {
            "bearer": []
          },
          {
            "access_token": []
          }
        ],
        "summary": "Lấy Presigned GET URL để xem file media (kiểm tra phân quyền tài liệu nhạy cảm)",
        "tags": ["media"]
      }
    },
    "/api/v1/health": {
      "get": {
        "operationId": "HealthController_check",
        "parameters": [],
        "responses": {
          "200": {
            "description": ""
          }
        },
        "tags": ["Health"]
      }
    },
    "/api/v1/vehicle-options": {
      "get": {
        "operationId": "VehiclesController_getVehicleOptions",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Danh mục tùy chọn cho phép tìm kiếm xe",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VehicleOptionsDto"
                }
              }
            }
          }
        },
        "summary": "Lấy danh mục các tùy chọn tìm kiếm xe (thành phố, loại xe, hộp số, tiện nghi)",
        "tags": ["Vehicles"]
      }
    },
    "/api/v1/vehicles": {
      "get": {
        "operationId": "VehiclesController_getVehicles",
        "parameters": [
          {
            "name": "city",
            "required": false,
            "in": "query",
            "description": "Tỉnh / thành phố tìm kiếm",
            "schema": {
              "example": "TP. Hồ Chí Minh",
              "type": "string"
            }
          },
          {
            "name": "startAt",
            "required": false,
            "in": "query",
            "description": "Thời điểm bắt đầu thuê (ISO 8601)",
            "schema": {
              "example": "2026-11-01T08:00:00Z",
              "type": "string"
            }
          },
          {
            "name": "endAt",
            "required": false,
            "in": "query",
            "description": "Thời điểm kết thúc thuê (ISO 8601)",
            "schema": {
              "example": "2026-11-03T18:00:00Z",
              "type": "string"
            }
          },
          {
            "name": "carType",
            "required": false,
            "in": "query",
            "description": "Phân khúc xe",
            "schema": {
              "type": "string",
              "enum": ["SEDAN", "SUV", "HATCHBACK", "MPV", "CROSSOVER"]
            }
          },
          {
            "name": "transmission",
            "required": false,
            "in": "query",
            "description": "Hộp số",
            "schema": {
              "type": "string",
              "enum": ["AUTO", "MANUAL"]
            }
          },
          {
            "name": "seats",
            "required": false,
            "in": "query",
            "description": "Số chỗ ngồi tối thiểu",
            "schema": {
              "example": 5,
              "type": "number"
            }
          },
          {
            "name": "minPrice",
            "required": false,
            "in": "query",
            "description": "Giá thuê ngày tối thiểu (VND)",
            "schema": {
              "example": 500000,
              "type": "number"
            }
          },
          {
            "name": "maxPrice",
            "required": false,
            "in": "query",
            "description": "Giá thuê ngày tối đa (VND)",
            "schema": {
              "example": 3000000,
              "type": "number"
            }
          },
          {
            "name": "keylessOnly",
            "required": false,
            "in": "query",
            "description": "Chỉ tìm xe hỗ trợ tự mở khóa Keyless",
            "schema": {
              "example": true,
              "type": "boolean"
            }
          },
          {
            "name": "sort",
            "required": false,
            "in": "query",
            "description": "Sắp xếp kết quả",
            "schema": {
              "default": "newest",
              "type": "string",
              "enum": ["price_asc", "price_desc", "newest", "rating_desc"]
            }
          },
          {
            "name": "page",
            "required": false,
            "in": "query",
            "description": "Số trang (1-indexed)",
            "schema": {
              "default": 1,
              "type": "number"
            }
          },
          {
            "name": "pageSize",
            "required": false,
            "in": "query",
            "description": "Số xe trên một trang",
            "schema": {
              "default": 10,
              "type": "number"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Danh sách xe thỏa mãn điều kiện lọc và thông tin phân trang",
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/VehicleSummaryDto"
                      }
                    },
                    "meta": {
                      "$ref": "#/components/schemas/PaginationMetaDto"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Tham số tìm kiếm hoặc khoảng ngày không hợp lệ"
          }
        },
        "summary": "Tìm kiếm và lấy danh sách xe đã được xuất bản (PUBLISHED)",
        "tags": ["Vehicles"]
      }
    },
    "/api/v1/owner/vehicles": {
      "post": {
        "operationId": "OwnerVehiclesController_createVehicle",
