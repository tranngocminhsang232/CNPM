    {
      "name": "Vehicles",
      "description": "Tìm kiếm xe và danh mục tùy chọn công khai"
    },
    {
      "name": "Auth",
      "description": "Xác thực, phân quyền và quản lý phiên người dùng"
    },
    {
      "name": "Users",
      "description": "Hồ sơ người dùng và xác thực giấy phép lái xe (KYC)"
    }
  ],
  "servers": [],
  "components": {
    "schemas": {
      "UserDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "ID người dùng (UUID)",
            "example": "00000000-0000-0000-0000-000000000001"
          },
          "name": {
            "type": "string",
            "description": "Họ và tên",
            "example": "Nguyễn Văn Chủ 1"
          },
          "email": {
            "type": "string",
            "description": "Email tài khoản",
            "example": "owner1@carsharing.local"
          },
          "phone": {
            "type": "string",
            "description": "Số điện thoại",
            "example": "0901111111"
          },
          "capabilities": {
            "description": "Danh sách năng lực (Capability Model): RENTER, OWNER",
            "example": ["RENTER", "OWNER"],
            "type": "array",
            "items": {
              "type": "array"
            }
          }
        },
        "required": ["id", "name", "email", "phone", "capabilities"]
      },
      "AuthResponseDto": {
        "type": "object",
        "properties": {
          "user": {
            "description": "Thông tin tài khoản người dùng",
            "allOf": [
              {
                "$ref": "#/components/schemas/UserDto"
              }
            ]
          },
          "csrfToken": {
            "type": "string",
            "description": "Mã xác thực chống CSRF gắn phiên",
            "example": "a1b2c3d4..."
          }
        },
        "required": ["user", "csrfToken"]
      },
      "CsrfResponseDto": {
        "type": "object",
        "properties": {
          "csrfToken": {
            "type": "string",
            "description": "CSRF token gắn phiên hoặc trước phiên",
            "example": "a1b2c3d4..."
          }
        },
        "required": ["csrfToken"]
      },
      "LoginDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "description": "Địa chỉ email đăng nhập",
            "example": "owner1@carsharing.local"
          },
          "password": {
            "type": "string",
            "description": "Mật khẩu tài khoản (tối thiểu 6 ký tự)",
            "example": "DemoPassword123!"
          }
        },
        "required": ["email", "password"]
      },
      "RegisterDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Họ và tên người dùng (2 - 100 ký tự)",
            "example": "Nguyễn Văn A"
          },
          "email": {
            "type": "string",
            "description": "Địa chỉ email đăng ký",
            "example": "user@example.com"
          },
          "password": {
            "type": "string",
            "description": "Mật khẩu bảo mật (12 - 128 ký tự)",
            "example": "StrongPassword2026!#"
          },
          "phone": {
            "type": "string",
            "description": "Số điện thoại liên hệ (9 - 15 chữ số)",
            "example": "0901234567"
          }
        },
        "required": ["name", "email", "password", "phone"]
      },
      "DriverLicenseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "ID hồ sơ GPLX (UUID)",
            "example": "40000000-0000-0000-0000-000000000001"
          },
          "userId": {
            "type": "string",
            "description": "ID chủ tài khoản (UUID)",
            "example": "00000000-0000-0000-0000-000000000001"
          },
          "licenseNumber": {
            "type": "string",
            "description": "Số Giấy phép lái xe",
            "example": "079199012345"
          },
          "fullName": {
            "type": "string",
            "description": "Họ và tên người lái xe",
            "example": "NGUYỄN VĂN CHỦ"
          },
          "dateOfBirth": {
            "type": "string",
            "description": "Ngày sinh (YYYY-MM-DD)",
            "example": "1995-05-15"
          },
          "licenseClass": {
            "type": "string",
            "description": "Hạng GPLX",
            "example": "B2"
          },
          "expiryDate": {
            "type": "string",
            "description": "Ngày hết hạn (YYYY-MM-DD)",
            "example": "2030-05-15"
          },
          "status": {
            "type": "string",
            "description": "Trạng thái xác thực KYC",
            "example": "PENDING",
            "enum": ["NONE", "PENDING", "VERIFIED", "REJECTED"]
          },
          "verifiedAt": {
            "type": "object",
            "description": "Thời điểm duyệt xác minh",
            "nullable": true
          },
          "rejectionReason": {
            "type": "object",
            "description": "Lý do từ chối xác thực",
            "nullable": true
          }
        },
        "required": [
          "id",
          "userId",
          "licenseNumber",
          "fullName",
          "dateOfBirth",
          "licenseClass",
          "expiryDate",
          "status"
        ]
      },
      "SubmitDriverLicenseDto": {
        "type": "object",
        "properties": {
          "licenseNumber": {
            "type": "string",
            "description": "Số Giấy phép lái xe (đúng 12 chữ số chuẩn Việt Nam)",
            "example": "079199012345"
          },
          "fullName": {
            "type": "string",
            "description": "Họ và tên ghi trên GPLX (2 - 100 ký tự)",
            "example": "NGUYỄN VĂN CHỦ"
          },
          "dateOfBirth": {
            "type": "string",
            "description": "Ngày sinh định dạng ISO 8601 (YYYY-MM-DD)",
            "example": "1995-05-15"
          },
          "licenseClass": {
            "type": "string",
            "description": "Hạng GPLX hợp lệ (B1, B2, C, D, E, FB2, FC, FD, FE)",
            "example": "B2",
            "enum": ["B1", "B2", "C", "D", "E", "FB2", "FC", "FD", "FE"]
          },
          "expiryDate": {
            "type": "string",
            "description": "Ngày hết hạn GPLX (bắt buộc còn hạn ít nhất 30 ngày)",
            "example": "2030-05-15"
          }
        },
        "required": ["licenseNumber", "fullName", "dateOfBirth", "licenseClass", "expiryDate"]
      },
      "VerifyDriverLicenseDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "description": "Trạng thái xác thực GPLX",
            "example": "VERIFIED",
            "enum": ["VERIFIED", "REJECTED"]
          },
          "rejectionReason": {
            "type": "string",
            "description": "Lý do từ chối (bắt buộc nếu REJECTED)",
            "example": "Ảnh chụp GPLX bị mờ, không rõ số hiệu"
          }
        },
        "required": ["status"]
      },
      "CreateUploadIntentDto": {
        "type": "object",
        "properties": {
          "purpose": {
            "type": "string",
            "description": "Mục đích sử dụng media (VEHICLE_PHOTO, INSPECTION_PHOTO, IDENTITY_DOCUMENT)",
            "example": "IDENTITY_DOCUMENT",
            "enum": ["VEHICLE_PHOTO", "INSPECTION_PHOTO", "IDENTITY_DOCUMENT"]
          },
          "mimeType": {
            "type": "string",
            "description": "Định dạng MIME hợp lệ (chỉ hỗ trợ image/jpeg hoặc image/png)",
            "example": "image/jpeg",
            "enum": ["image/jpeg", "image/png"]
          },
          "sizeBytes": {
            "type": "number",
            "description": "Dung lượng file tính bằng bytes (tối đa 5.242.880 bytes ~ 5 MiB)",
            "example": 1048576
          },
          "vehicleId": {
            "type": "string",
            "description": "ID xe liên quan (nếu là VEHICLE_PHOTO)",
            "example": "10000000-0000-0000-0000-000000000001"
          },
          "bookingId": {
            "type": "string",
            "description": "ID booking liên quan (nếu là INSPECTION_PHOTO)",
            "example": "20000000-0000-0000-0000-000000000001"
          }
        },
        "required": ["purpose", "mimeType", "sizeBytes"]
      },
      "UploadIntentResponseDto": {
        "type": "object",
        "properties": {
          "mediaId": {
            "type": "string",
            "description": "ID định danh duy nhất của media (UUID)",
            "example": "50000000-0000-0000-0000-000000000001"
          },
          "uploadUrl": {
            "type": "string",
            "description": "Presigned URL để thực hiện PUT upload trực tiếp lên S3/MinIO"
          },
          "headers": {
            "type": "object",
            "description": "Headers bắt buộc phải gửi kèm khi PUT lên S3",
            "example": {
              "Content-Type": "image/jpeg"
            }
          },
          "expiresAt": {
            "type": "string",
            "description": "Thời điểm hết hạn của presigned URL upload (ISO 8601 UTC)"
          }
        },
        "required": ["mediaId", "uploadUrl", "headers", "expiresAt"]
      },
      "MediaObjectDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "ID media (UUID)",
            "example": "50000000-0000-0000-0000-000000000001"
          },
          "uploaderId": {
            "type": "string",
            "description": "ID người tải lên (UUID)",
            "example": "00000000-0000-0000-0000-000000000001"
          },
          "purpose": {
            "type": "string",
            "description": "Mục đích sử dụng media",
            "example": "IDENTITY_DOCUMENT"
          },
          "mimeType": {
            "type": "string",
            "description": "Định dạng MIME",
            "example": "image/jpeg"
          },
          "sizeBytes": {
            "type": "number",
            "description": "Dung lượng bytes",
            "example": 1048576
          },
          "state": {
            "type": "string",
            "description": "Trạng thái media",
            "example": "VERIFIED",
            "enum": ["STAGING", "VERIFIED", "REJECTED"]
          },
          "verifiedAt": {
            "type": "object",
            "description": "Thời điểm xác minh file",
            "nullable": true
          }
        },
        "required": ["id", "uploaderId", "purpose", "mimeType", "sizeBytes", "state"]
      },
      "MediaReadUrlResponseDto": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "description": "Presigned URL để tải hoặc xem ảnh từ private S3 bucket"
          },
          "expiresAt": {
            "type": "string",
            "description": "Thời điểm hết hạn của presigned URL xem file (ISO 8601 UTC)"
          }
        },
        "required": ["url", "expiresAt"]
      },
      "VehicleSummaryDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "10000000-0000-0000-0000-000000000001"
          },
          "brand": {
            "type": "string",
            "example": "VinFast"
          },
          "model": {
            "type": "string",
            "example": "VF8 Plus"
          },
          "year": {
            "type": "number",
            "example": 2024
          },
          "city": {
            "type": "string",
            "example": "TP. Hồ Chí Minh"
          },
          "carType": {
            "type": "string",
            "enum": ["SEDAN", "SUV", "HATCHBACK", "MPV", "CROSSOVER"],
            "example": "SUV"
          },
          "transmission": {
            "type": "string",
            "enum": ["AUTO", "MANUAL"],
            "example": "AUTO"
          },
          "seats": {
            "type": "number",
            "example": 5
          },
          "amenities": {
            "example": ["GPS", "BLUETOOTH", "BACKUP_CAMERA"],
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "keylessSupported": {
            "type": "boolean",
            "example": true
          },
          "pricePerDayVnd": {
            "type": "number",
            "example": 1400000,
            "description": "Giá thuê một ngày (VND, số nguyên an toàn)"
          },
          "coverImageUrl": {
            "type": "object",
            "example": "http://localhost:4000/api/v1/media/vehicles/10000000-0000-0000-0000-000000000001/cover.jpg",
            "nullable": true
          },
          "ratingAverage": {
            "type": "number",
            "example": 5,
            "description": "Điểm đánh giá trung bình"
          },
          "reviewCount": {
            "type": "number",
            "example": 0,
            "description": "Tổng số lượt đánh giá"
          },
          "quote": {
            "type": "object",
            "description": "Báo giá tính nhanh (nếu có yêu cầu khoảng ngày)"
          }
        },
        "required": [
          "id",
          "brand",
          "model",
          "year",
          "city",
          "carType",
          "transmission",
          "seats",
          "amenities",
          "keylessSupported",
          "pricePerDayVnd",
          "ratingAverage",
          "reviewCount"
        ]
      },
      "PaginationMetaDto": {
        "type": "object",
        "properties": {
          "page": {
            "type": "number",
            "example": 1
          },
          "pageSize": {
            "type": "number",
            "example": 10
          },
          "total": {
            "type": "number",
            "example": 12
          },
          "totalPages": {
            "type": "number",
            "example": 2
          }
        },
        "required": ["page", "pageSize", "total", "totalPages"]
      },
      "AmenityOptionDto": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "example": "GPS"
          },
          "name": {
            "type": "string",
            "example": "Định vị GPS"
          }
        },
        "required": ["code", "name"]
      },
      "VehicleOptionsDto": {
        "type": "object",
        "properties": {
          "cities": {
            "example": ["TP. Hồ Chí Minh", "Hà Nội", "Đà Nẵng"],
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "carTypes": {
            "example": ["SEDAN", "SUV", "HATCHBACK", "MPV", "CROSSOVER"],
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "transmissions": {
            "example": ["AUTO", "MANUAL"],
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "amenities": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AmenityOptionDto"
            }
          }
        },
        "required": ["cities", "carTypes", "transmissions", "amenities"]
      },
      "CreateVehicleDto": {
        "type": "object",
        "properties": {
          "brand": {
            "type": "string",
            "description": "Hãng xe",
            "example": "Toyota"
          },
          "model": {
            "type": "string",
            "description": "Dòng xe / Model",
            "example": "Corolla Cross"
          },
          "year": {
            "type": "number",
            "description": "Năm sản xuất",
            "example": 2023
          },
          "licensePlate": {
            "type": "string",
            "description": "Biển số xe",
            "example": "51K-123.45"
          },
          "city": {
            "type": "string",
            "description": "Thành phố hoạt động",
            "example": "TP. Hồ Chí Minh",
            "enum": ["TP. Hồ Chí Minh", "Hà Nội", "Đà Nẵng"]
          },
          "pickupAddress": {
            "type": "string",
            "description": "Địa chỉ đón/trả xe chính xác",
            "example": "123 Nguyễn Huệ, Quận 1, TP. Hồ Chí Minh"
          },
          "carType": {
            "type": "string",
            "description": "Phân khúc xe",
            "enum": ["SEDAN", "SUV", "HATCHBACK", "MPV", "CROSSOVER"],
            "example": "SUV"
          },
          "transmission": {
            "type": "string",
            "description": "Hộp số",
            "enum": ["AUTO", "MANUAL"],
            "example": "AUTO"
          },
          "seats": {
            "type": "number",
            "description": "Số chỗ ngồi",
            "example": 5
          },
          "description": {
            "type": "string",
            "description": "Mô tả chi tiết về xe",
            "example": "Xe gia đình giữ gìn sạch sẽ, bảo dưỡng định kỳ."
          },
          "pricePerDayVnd": {
            "type": "number",
            "description": "Giá thuê một ngày (VND)",
            "example": 1200000
          },
          "keylessSupported": {
            "type": "boolean",
            "description": "Hỗ trợ nhận xe tự động không chìa (Keyless)",
            "default": false
          },
          "amenities": {
            "description": "Danh sách mã tiện nghi",
            "example": ["GPS", "BLUETOOTH", "BACKUP_CAMERA"],
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "photoMediaIds": {
            "description": "Danh sách ID media ảnh xe đã upload và verify",
            "example": ["50000000-0000-0000-0000-000000000001"],
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "brand",
          "model",
          "year",
          "licensePlate",
          "city",
          "pickupAddress",
          "carType",
          "transmission",
          "seats",
          "description",
          "pricePerDayVnd"
        ]
      },
      "VehiclePhotoDto": {
        "type": "object",
        "properties": {
          "mediaId": {
            "type": "string",
            "description": "ID media"
          },
          "position": {
            "type": "number",
            "description": "Thứ tự hiển thị (0 là ảnh bìa)"
          }
        },
        "required": ["mediaId", "position"]
      },
      "OwnerVehicleDto": {
