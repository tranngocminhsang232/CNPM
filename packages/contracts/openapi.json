{
  "openapi": "3.0.0",
  "paths": {
    "/api/v1/auth/csrf": {
      "get": {
        "operationId": "AuthController_getCsrfToken",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Trả về CSRF token và gắn cookie csrf_token",
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/CsrfResponseDto"
                    }
                  }
                }
              }
            }
          }
        },
        "summary": "Lấy mã xác thực CSRF gắn phiên hoặc trước phiên",
        "tags": ["Auth"]
      }
    },
    "/api/v1/auth/login": {
      "post": {
        "operationId": "AuthController_login",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Đăng nhập thành công, thiết lập session cookies",
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/AuthResponseDto"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Sai thông tin đăng nhập (INVALID_CREDENTIALS)"
          }
        },
        "summary": "Đăng nhập người dùng bằng email và mật khẩu",
        "tags": ["Auth"]
      }
    },
    "/api/v1/auth/register": {
      "post": {
        "operationId": "AuthController_register",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterDto"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Đăng ký thành công, tạo phiên và trả về thông tin user",
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/AuthResponseDto"
                    }
                  }
                }
              }
            }
          },
          "409": {
            "description": "Email đã tồn tại (EMAIL_IN_USE)"
          }
        },
        "summary": "Đăng ký tài khoản người dùng mới",
        "tags": ["Auth"]
      }
    },
    "/api/v1/auth/google": {
      "get": {
        "operationId": "AuthController_googleAuth",
        "parameters": [],
        "responses": {
          "302": {
            "description": "Chuyển hướng đến Google hoặc mock callback"
          }
        },
        "summary": "Khởi tạo luồng xác thực Google OAuth2/OIDC",
        "tags": ["Auth"]
      }
    },
    "/api/v1/auth/google/callback": {
      "get": {
        "operationId": "AuthController_googleCallback",
        "parameters": [
          {
            "name": "code",
            "required": true,
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "302": {
            "description": "Thiết lập cookie phiên và chuyển hướng về web"
          }
        },
        "summary": "Xử lý phản hồi từ Google OAuth2/OIDC",
        "tags": ["Auth"]
      }
    },
    "/api/v1/auth/logout": {
      "post": {
        "operationId": "AuthController_logout",
        "parameters": [],
        "responses": {
          "204": {
            "description": "Đăng xuất thành công, xóa cookie"
          }
        },
        "summary": "Đăng xuất tài khoản và thu hồi phiên làm việc",
        "tags": ["Auth"]
      }
    },
    "/api/v1/auth/me": {
      "get": {
        "operationId": "AuthController_getProfile[0]",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Thông tin tài khoản và năng lực của người dùng",
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/UserDto"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Chưa đăng nhập hoặc phiên hết hạn"
          }
        },
        "summary": "Lấy thông tin người dùng hiện tại từ phiên đăng nhập",
        "tags": ["Auth"]
      }
    },
    "/api/v1/me": {
      "get": {
        "operationId": "AuthController_getProfile[1]",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Thông tin tài khoản và năng lực của người dùng",
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/UserDto"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Chưa đăng nhập hoặc phiên hết hạn"
          }
        },
        "summary": "Lấy thông tin người dùng hiện tại từ phiên đăng nhập",
        "tags": ["Auth"]
      }
    },
    "/api/v1/users/me/driver-license": {
      "get": {
        "operationId": "UsersController_getMyDriverLicense",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Hồ sơ GPLX của người dùng hoặc null nếu chưa nộp",
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/DriverLicenseDto",
                      "nullable": true
                    }
                  }
                }
              }
            }
          }
        },
        "summary": "Xem thông tin giấy phép lái xe hiện tại của tôi",
        "tags": ["Users"]
      },
      "post": {
        "operationId": "UsersController_submitDriverLicense",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SubmitDriverLicenseDto"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Nộp GPLX thành công, trạng thái chuyển sang PENDING",
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/DriverLicenseDto"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Dữ liệu không hợp lệ (hết hạn, < 18 tuổi, sai số GPLX)"
          },
          "409": {
            "description": "GPLX đã được xác thực trước đó (ALREADY_VERIFIED)"
          }
        },
        "summary": "Nộp thông tin giấy phép lái xe (GPLX) để xác thực KYC",
        "tags": ["Users"]
      }
    },
    "/api/v1/users/{id}/driver-license/verify": {
      "post": {
        "operationId": "UsersController_verifyDriverLicense",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "description": "ID người dùng cần duyệt GPLX",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/VerifyDriverLicenseDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Cập nhật trạng thái KYC thành công",
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/DriverLicenseDto"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Không tìm thấy hồ sơ GPLX của người dùng"
          }
        },
        "summary": "Duyệt hoặc từ chối giấy phép lái xe (Admin / Mock Verification)",
        "tags": ["Users"]
      }
    },
    "/api/v1/health": {
      "get": {
        "operationId": "HealthController_check",
        "parameters": [],
        "responses": {
          "200": {
            "description": ""
          }
        },
        "tags": ["Health"]
      }
    },
    "/api/v1/vehicle-options": {
      "get": {
        "operationId": "VehiclesController_getVehicleOptions",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Danh mục tùy chọn cho phép tìm kiếm xe",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VehicleOptionsDto"
                }
              }
            }
          }
        },
        "summary": "Lấy danh mục các tùy chọn tìm kiếm xe (thành phố, loại xe, hộp số, tiện nghi)",
        "tags": ["Vehicles"]
      }
    },
    "/api/v1/vehicles": {
      "get": {
        "operationId": "VehiclesController_getVehicles",
        "parameters": [
          {
            "name": "city",
            "required": false,
            "in": "query",
            "description": "Tỉnh / thành phố tìm kiếm",
            "schema": {
              "example": "TP. Hồ Chí Minh",
              "type": "string"
            }
          },
          {
            "name": "startAt",
            "required": false,
            "in": "query",
            "description": "Thời điểm bắt đầu thuê (ISO 8601)",
            "schema": {
              "example": "2026-11-01T08:00:00Z",
              "type": "string"
            }
          },
          {
            "name": "endAt",
            "required": false,
            "in": "query",
            "description": "Thời điểm kết thúc thuê (ISO 8601)",
            "schema": {
              "example": "2026-11-03T18:00:00Z",
              "type": "string"
            }
          },
          {
            "name": "carType",
            "required": false,
            "in": "query",
            "description": "Phân khúc xe",
            "schema": {
              "type": "string",
              "enum": ["SEDAN", "SUV", "HATCHBACK", "MPV", "CROSSOVER"]
            }
          },
          {
            "name": "transmission",
            "required": false,
            "in": "query",
            "description": "Hộp số",
            "schema": {
              "type": "string",
              "enum": ["AUTO", "MANUAL"]
            }
          },
          {
            "name": "seats",
            "required": false,
            "in": "query",
            "description": "Số chỗ ngồi tối thiểu",
            "schema": {
              "example": 5,
              "type": "number"
            }
          },
          {
            "name": "minPrice",
            "required": false,
            "in": "query",
            "description": "Giá thuê ngày tối thiểu (VND)",
            "schema": {
              "example": 500000,
              "type": "number"
            }
          },
          {
            "name": "maxPrice",
            "required": false,
            "in": "query",
            "description": "Giá thuê ngày tối đa (VND)",
            "schema": {
              "example": 3000000,
              "type": "number"
            }
          },
          {
            "name": "keylessOnly",
            "required": false,
            "in": "query",
            "description": "Chỉ tìm xe hỗ trợ tự mở khóa Keyless",
            "schema": {
              "example": true,
              "type": "boolean"
            }
          },
          {
            "name": "sort",
            "required": false,
            "in": "query",
            "description": "Sắp xếp kết quả",
            "schema": {
              "default": "newest",
              "type": "string",
              "enum": ["price_asc", "price_desc", "newest", "rating_desc"]
            }
          },
          {
            "name": "page",
            "required": false,
            "in": "query",
            "description": "Số trang (1-indexed)",
            "schema": {
              "default": 1,
              "type": "number"
            }
          },
          {
            "name": "pageSize",
            "required": false,
            "in": "query",
            "description": "Số xe trên một trang",
            "schema": {
              "default": 10,
              "type": "number"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Danh sách xe thỏa mãn điều kiện lọc và thông tin phân trang",
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/VehicleSummaryDto"
                      }
                    },
                    "meta": {
                      "$ref": "#/components/schemas/PaginationMetaDto"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Tham số tìm kiếm hoặc khoảng ngày không hợp lệ"
          }
        },
        "summary": "Tìm kiếm và lấy danh sách xe đã được xuất bản (PUBLISHED)",
        "tags": ["Vehicles"]
      }
    }
  },
  "info": {
    "title": "Car Sharing Platform API",
    "description": "Nền tảng chia sẻ xe tự lái (Car Sharing MVP) - API Contract v1.1",
    "version": "1.0",
    "contact": {}
  },
  "tags": [
    {
      "name": "Health",
      "description": "Kiểm tra trạng thái liveness & readiness của hệ thống"
    },
    {
      "name": "Vehicles",
      "description": "Tìm kiếm xe và danh mục tùy chọn công khai"
    },
    {
      "name": "Auth",
      "description": "Xác thực, phân quyền và quản lý phiên người dùng"
    },
    {
      "name": "Users",
      "description": "Hồ sơ người dùng và xác thực giấy phép lái xe (KYC)"
    }
  ],
  "servers": [],
  "components": {
    "schemas": {
      "UserDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "ID người dùng (UUID)",
            "example": "00000000-0000-0000-0000-000000000001"
          },
          "name": {
            "type": "string",
            "description": "Họ và tên",
            "example": "Nguyễn Văn Chủ 1"
          },
          "email": {
            "type": "string",
            "description": "Email tài khoản",
            "example": "owner1@carsharing.local"
          },
          "phone": {
            "type": "string",
            "description": "Số điện thoại",
            "example": "0901111111"
          },
          "capabilities": {
            "description": "Danh sách năng lực (Capability Model): RENTER, OWNER",
            "example": ["RENTER", "OWNER"],
            "type": "array",
            "items": {
              "type": "array"
            }
          }
        },
        "required": ["id", "name", "email", "phone", "capabilities"]
      },
      "AuthResponseDto": {
        "type": "object",
        "properties": {
          "user": {
            "description": "Thông tin tài khoản người dùng",
            "allOf": [
              {
                "$ref": "#/components/schemas/UserDto"
              }
            ]
          },
          "csrfToken": {
            "type": "string",
            "description": "Mã xác thực chống CSRF gắn phiên",
            "example": "a1b2c3d4..."
          }
        },
        "required": ["user", "csrfToken"]
      },
      "CsrfResponseDto": {
        "type": "object",
        "properties": {
          "csrfToken": {
            "type": "string",
            "description": "CSRF token gắn phiên hoặc trước phiên",
            "example": "a1b2c3d4..."
          }
        },
        "required": ["csrfToken"]
      },
      "LoginDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "description": "Địa chỉ email đăng nhập",
            "example": "owner1@carsharing.local"
          },
          "password": {
            "type": "string",
            "description": "Mật khẩu tài khoản (tối thiểu 6 ký tự)",
            "example": "DemoPassword123!"
          }
        },
        "required": ["email", "password"]
      },
      "RegisterDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Họ và tên người dùng (2 - 100 ký tự)",
            "example": "Nguyễn Văn A"
          },
          "email": {
            "type": "string",
            "description": "Địa chỉ email đăng ký",
            "example": "user@example.com"
          },
          "password": {
            "type": "string",
            "description": "Mật khẩu bảo mật (12 - 128 ký tự)",
            "example": "StrongPassword2026!#"
          },
          "phone": {
            "type": "string",
            "description": "Số điện thoại liên hệ (9 - 15 chữ số)",
            "example": "0901234567"
          }
        },
        "required": ["name", "email", "password", "phone"]
      },
      "DriverLicenseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "ID hồ sơ GPLX (UUID)",
            "example": "40000000-0000-0000-0000-000000000001"
          },
          "userId": {
            "type": "string",
            "description": "ID chủ tài khoản (UUID)",
            "example": "00000000-0000-0000-0000-000000000001"
          },
          "licenseNumber": {
            "type": "string",
            "description": "Số Giấy phép lái xe",
            "example": "079199012345"
          },
          "fullName": {
            "type": "string",
            "description": "Họ và tên người lái xe",
            "example": "NGUYỄN VĂN CHỦ"
          },
          "dateOfBirth": {
            "type": "string",
            "description": "Ngày sinh (YYYY-MM-DD)",
            "example": "1995-05-15"
          },
          "licenseClass": {
            "type": "string",
            "description": "Hạng GPLX",
            "example": "B2"
          },
          "expiryDate": {
            "type": "string",
            "description": "Ngày hết hạn (YYYY-MM-DD)",
            "example": "2030-05-15"
          },
          "status": {
            "type": "string",
            "description": "Trạng thái xác thực KYC",
            "example": "PENDING",
            "enum": ["NONE", "PENDING", "VERIFIED", "REJECTED"]
          },
          "verifiedAt": {
            "type": "object",
            "description": "Thời điểm duyệt xác minh",
            "nullable": true
          },
          "rejectionReason": {
            "type": "object",
            "description": "Lý do từ chối xác thực",
            "nullable": true
          }
        },
        "required": [
          "id",
          "userId",
          "licenseNumber",
          "fullName",
          "dateOfBirth",
          "licenseClass",
          "expiryDate",
          "status"
        ]
      },
      "SubmitDriverLicenseDto": {
        "type": "object",
        "properties": {
          "licenseNumber": {
            "type": "string",
            "description": "Số Giấy phép lái xe (đúng 12 chữ số chuẩn Việt Nam)",
            "example": "079199012345"
          },
          "fullName": {
            "type": "string",
            "description": "Họ và tên ghi trên GPLX (2 - 100 ký tự)",
            "example": "NGUYỄN VĂN CHỦ"
          },
          "dateOfBirth": {
            "type": "string",
            "description": "Ngày sinh định dạng ISO 8601 (YYYY-MM-DD)",
            "example": "1995-05-15"
          },
          "licenseClass": {
            "type": "string",
            "description": "Hạng GPLX hợp lệ (B1, B2, C, D, E, FB2, FC, FD, FE)",
            "example": "B2",
            "enum": ["B1", "B2", "C", "D", "E", "FB2", "FC", "FD", "FE"]
          },
          "expiryDate": {
            "type": "string",
            "description": "Ngày hết hạn GPLX (bắt buộc còn hạn ít nhất 30 ngày)",
            "example": "2030-05-15"
          }
        },
        "required": ["licenseNumber", "fullName", "dateOfBirth", "licenseClass", "expiryDate"]
      },
      "VerifyDriverLicenseDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "description": "Trạng thái xác thực GPLX",
            "example": "VERIFIED",
            "enum": ["VERIFIED", "REJECTED"]
          },
          "rejectionReason": {
            "type": "string",
            "description": "Lý do từ chối (bắt buộc nếu REJECTED)",
            "example": "Ảnh chụp GPLX bị mờ, không rõ số hiệu"
          }
        },
        "required": ["status"]
      },
      "VehicleSummaryDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "10000000-0000-0000-0000-000000000001"
          },
          "brand": {
            "type": "string",
            "example": "VinFast"
          },
          "model": {
            "type": "string",
            "example": "VF8 Plus"
          },
          "year": {
            "type": "number",
            "example": 2024
          },
          "city": {
            "type": "string",
            "example": "TP. Hồ Chí Minh"
          },
          "carType": {
            "type": "string",
            "enum": ["SEDAN", "SUV", "HATCHBACK", "MPV", "CROSSOVER"],
            "example": "SUV"
          },
          "transmission": {
            "type": "string",
            "enum": ["AUTO", "MANUAL"],
            "example": "AUTO"
          },
          "seats": {
            "type": "number",
            "example": 5
          },
          "amenities": {
            "example": ["GPS", "BLUETOOTH", "BACKUP_CAMERA"],
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "keylessSupported": {
            "type": "boolean",
            "example": true
          },
          "pricePerDayVnd": {
            "type": "number",
            "example": 1400000,
            "description": "Giá thuê một ngày (VND, số nguyên an toàn)"
          },
          "coverImageUrl": {
            "type": "object",
            "example": "http://localhost:4000/api/v1/media/vehicles/10000000-0000-0000-0000-000000000001/cover.jpg",
            "nullable": true
          },
          "ratingAverage": {
            "type": "number",
            "example": 5,
            "description": "Điểm đánh giá trung bình"
          },
          "reviewCount": {
            "type": "number",
            "example": 0,
            "description": "Tổng số lượt đánh giá"
          },
          "quote": {
            "type": "object",
            "description": "Báo giá tính nhanh (nếu có yêu cầu khoảng ngày)"
          }
        },
        "required": [
          "id",
          "brand",
          "model",
          "year",
          "city",
          "carType",
          "transmission",
          "seats",
          "amenities",
          "keylessSupported",
          "pricePerDayVnd",
          "ratingAverage",
          "reviewCount"
        ]
      },
      "PaginationMetaDto": {
        "type": "object",
        "properties": {
          "page": {
            "type": "number",
            "example": 1
          },
          "pageSize": {
            "type": "number",
            "example": 10
          },
          "total": {
            "type": "number",
            "example": 12
          },
          "totalPages": {
            "type": "number",
            "example": 2
          }
        },
        "required": ["page", "pageSize", "total", "totalPages"]
      },
      "AmenityOptionDto": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "example": "GPS"
          },
          "name": {
            "type": "string",
            "example": "Định vị GPS"
          }
        },
        "required": ["code", "name"]
      },
      "VehicleOptionsDto": {
        "type": "object",
        "properties": {
          "cities": {
            "example": ["TP. Hồ Chí Minh", "Hà Nội", "Đà Nẵng"],
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "carTypes": {
            "example": ["SEDAN", "SUV", "HATCHBACK", "MPV", "CROSSOVER"],
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "transmissions": {
            "example": ["AUTO", "MANUAL"],
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "amenities": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AmenityOptionDto"
            }
          }
        },
        "required": ["cities", "carTypes", "transmissions", "amenities"]
      }
    }
  }
}
