          },
          "404": {
            "description": "Không tìm thấy xe"
          }
        },
        "security": [
          {
            "bearer": []
          },
          {
            "access_token": []
          }
        ],
        "summary": "Chủ xe cập nhật thông tin xe",
        "tags": ["owner-vehicles"]
      }
    },
    "/api/v1/owner/vehicles/{id}/publish": {
      "post": {
        "operationId": "OwnerVehiclesController_publishVehicle",
        "parameters": [
          {
            "name": "id",
            "required": true,
