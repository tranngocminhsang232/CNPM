        },
        "security": [
          {
            "bearer": []
          },
          {
            "access_token": []
          }
        ],
        "summary": "Chuyển trạng thái xe từ DRAFT sang PUBLISHED để hiển thị trên danh sách tìm kiếm công khai",
        "tags": ["owner-vehicles"]
      }
    }
  },
  "info": {
