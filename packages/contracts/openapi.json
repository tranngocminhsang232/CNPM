                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          },
          {
            "access_token": []
          }
        ],
        "summary": "Lấy danh sách toàn bộ xe thuộc sở hữu của chủ xe hiện tại",
        "tags": ["owner-vehicles"]
      }
    },
    "/api/v1/owner/vehicles/{id}": {
