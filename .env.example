# ==============================================================================
# CAR SHARING APPLICATION - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Lưu ý: Đây là file mẫu cho môi trường phát triển local.
# KHÔNG ghi secret thật vào file này hoặc commit file .env chứa secret thật lên Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Ứng dụng & Cổng dịch vụ (App & Server)
# ------------------------------------------------------------------------------
NODE_ENV=development
API_PORT=4000
WEB_PORT=3000
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:3000

# ------------------------------------------------------------------------------
# 2. Cơ sở dữ liệu (PostgreSQL)
# Cổng mặc định Docker Compose là 5433 để tránh xung đột với PostgreSQL host (5432).
# Nếu dùng trực tiếp PostgreSQL native trên máy, đổi cổng thành 5432.
# ------------------------------------------------------------------------------
POSTGRES_USER=carsharing
POSTGRES_PASSWORD=carsharing_local_password
POSTGRES_DB=carsharing_dev
POSTGRES_TEST_DB=carsharing_test
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

DATABASE_URL="postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}?schema=public"
DATABASE_TEST_URL="postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_TEST_DB}?schema=public"

# ------------------------------------------------------------------------------
# 3. Lưu trữ Object Storage (S3-compatible / MinIO Local)
# ------------------------------------------------------------------------------
S3_ENDPOINT=http://localhost:9000
S3_CONSOLE_PORT=9001
S3_REGION=us-east-1
S3_BUCKET_PRIVATE=car-sharing-private
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_USE_SSL=false
S3_PRESIGNED_EXPIRES_SECONDS=900

# ------------------------------------------------------------------------------
# 4. Xác thực & Quản lý phiên (JWT & Cookies - ADR-16)
# ------------------------------------------------------------------------------
JWT_ACCESS_SECRET=local-dev-jwt-access-secret-minimum-32-characters-required
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=local-dev-jwt-refresh-secret-minimum-32-characters-required
JWT_REFRESH_EXPIRES_IN=7d
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false

# ------------------------------------------------------------------------------
# 5. Google OAuth 2.0 / OIDC (ADR-04)
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID=placeholder-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=placeholder-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3000/api/v1/auth/google/callback

# ------------------------------------------------------------------------------
# 6. Thiết bị ảo hóa Keyless Simulator (ADR-12, ADR-13)
# ------------------------------------------------------------------------------
KEYLESS_SIMULATOR_TIMEOUT_MS=5000
KEYLESS_SIMULATOR_FAIL_RATE=0
